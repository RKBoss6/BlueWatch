    "Location: Used to send location and weather, as well as act as a GPS for your watch.": {
      "comment": "A description of the location permission.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Localisation : utilisée pour envoyer la position et les données météo, ainsi que pour servir de GPS à votre montre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort: Wird zum Senden von Standort- und Wetterdaten sowie als GPS für Ihre Uhr verwendet."
          }
        }
      }
    },
    "Lowers chunk size from 40 to 15 bytes for more reliable Bluetooth transmissions. Highly recommended.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Réduit la taille des blocs de 40 à 15 octets pour des transmissions Bluetooth plus fiables. Fortement recommandé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziert die Paketgröße von 40 auf 15 Byte für zuverlässigere Bluetooth-Übertragungen. Sehr empfohlen."
          }
        }
      }
    },
