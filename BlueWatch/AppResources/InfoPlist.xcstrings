    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch benötigt Bluetooth, um eine Verbindung zu Ihrer Uhr herzustellen und Daten zu senden und zu empfangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch needs Bluetooth to connect, send, and receive data from your watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch necesita Bluetooth para conectarse, enviar y recibir datos de tu reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch a besoin du Bluetooth pour se connecter à votre montre, et envoyer et recevoir des données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch को आपकी घड़ी से कनेक्ट करने, डेटा भेजने और प्राप्त करने के लिए ब्लूटूथ की आवश्यकता है।"
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription" : {
      "comment" : "Privacy - Bluetooth Peripheral Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch benötigt Bluetooth, um eine Verbindung zu Ihrer Uhr herzustellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch needs Bluetooth to connect to your watch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch necesita Bluetooth para conectarse a tu reloj"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch a besoin du Bluetooth pour se connecter à votre montre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch को आपकी घड़ी से कनेक्ट करने के लिए ब्लूटूथ की आवश्यकता है"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch liest Gesundheitsdaten, um eine aktuelle Synchronisierung mit Apple Health von Ihrer Uhr sicherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch reads health data to ensure up-to-date Apple health syncing from your watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch lee datos de salud para garantizar una sincronización actualizada con Salud de Apple desde tu reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch lit les données de santé pour garantir une synchronisation à jour avec Santé d'Apple depuis votre montre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch आपकी घड़ी से Apple Health के सिंक को अपडेट रखने के लिए स्वास्थ्य डेटा पढ़ता है।"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch benötigt Zugriff zum Aktualisieren von Apple Health, um Gesundheitsdaten von Ihrer Uhr an Health zu übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch needs access to update Apple Health so it can push health data from your watch to Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch necesita acceso para actualizar Salud de Apple y así enviar los datos de salud de tu reloj a Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch a besoin d'accéder à Santé pour pouvoir y transmettre les données de santé de votre montre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch को Apple Health को अपडेट करने के लिए एक्सेस की आवश्यकता है ताकि वह आपकी घड़ी से स्वास्थ्य डेटा Health में भेज सके।"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch benötigt den Standort, um das lokale Wetter und GPS-Daten für Ihre Uhr abzurufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch needs location to get local weather and GPS for your watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch necesita la ubicación para obtener el clima local y el GPS de tu reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch a besoin de la localisation pour obtenir la météo locale et le GPS de votre montre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch को आपकी घड़ी के लिए स्थानीय मौसम और GPS प्राप्त करने के लिए लोकेशन की आवश्यकता है।"
          }
        }
      }
    },
    "NSLocationAlwaysUsageDescription" : {
      "comment" : "Privacy - Location Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch benötigt regelmäßig im Hintergrund den Standort, um den Standort Ihres Geräts zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch needs location perodically in the background to update your device's location"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch necesita la ubicación periódicamente en segundo plano para actualizar la ubicación de tu dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch a besoin périodiquement de la localisation en arrière-plan pour mettre à jour la position de votre appareil"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch को आपके डिवाइस की लोकेशन अपडेट करने के लिए बैकग्राउंड में समय-समय पर लोकेशन की आवश्यकता होती है"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch benötigt den Standort, um das lokale Wetter abzurufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BlueWatch needs location to get local weather"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch necesita la ubicación para obtener el clima local"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch a besoin de la localisation pour obtenir la météo locale"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch को स्थानीय मौसम प्राप्त करने के लिए लोकेशन की आवश्यकता है"
          }
        }
      }
    }
  },
  "version" : "1.3"
}
