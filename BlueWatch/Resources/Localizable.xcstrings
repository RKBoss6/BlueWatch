    "BlueWatch can support different localizations and languages, depending on the system language set." : {
      "comment" : "A description of the languages supported by BlueWatch.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch kann je nach eingestellter Systemsprache unterschiedliche Lokalisierungen und Sprachen unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch puede admitir diferentes localizaciones e idiomas, según el idioma del sistema configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch peut prendre en charge différentes localisations et langues, selon la langue du système définie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम में सेट की गई भाषा के आधार पर, BlueWatch विभिन्न स्थानीयकरण और भाषाओं का समर्थन कर सकता है।"
          }
        }
      }
    },
    "BlueWatch can sync health data with Apple Health for a more comprehensive overview of your metrics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch kann Gesundheitsdaten mit Apple Health synchronisieren, um einen umfassenderen Überblick über Ihre Messwerte zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch puede sincronizar datos de salud con Apple Health para obtener una visión más completa de tus métricas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch peut synchroniser les données de santé avec Apple Health pour une vue d’ensemble plus complète de vos mesures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch आपके मेट्रिक्स का अधिक व्यापक अवलोकन प्राप्त करने के लिए Apple Health के साथ स्वास्थ्य डेटा सिंक कर सकता है।"
          }
        }
      }
    },
