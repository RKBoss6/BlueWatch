    "BlueWatch uses Bluetooth to pair and connect to your device, as well as receiving/sending data." : {
      "comment" : "Text displayed in a setup screen that describes the functionality of the Bluetooth feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch verwendet Bluetooth, um sich mit Ihrem Gerät zu koppeln und zu verbinden sowie um Daten zu empfangen/senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch utiliza Bluetooth para emparejarse y conectarse con tu dispositivo, así como para recibir/enviar datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch utilise le Bluetooth pour se coupler et se connecter à votre appareil, ainsi que pour recevoir/envoyer des données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch आपके डिवाइस से पेयर और कनेक्ट करने के साथ-साथ डेटा प्राप्त करने/भेजने के लिए ब्लूटूथ का उपयोग करता है।"
          }
        }
      }
    },
    "BlueWatch uses location to send periodic location updates to your watch, act as a watch GPS, and update weather on your watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch verwendet den Standort, um regelmäßig Standortaktualisierungen an Ihre Uhr zu senden, als GPS für die Uhr zu fungieren und das Wetter auf Ihrer Uhr zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch utiliza la ubicación para enviar actualizaciones periódicas de ubicación a tu reloj, actuar como GPS del reloj y actualizar el tiempo en tu reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch utilise la localisation pour envoyer périodiquement des mises à jour de position à votre montre, faire office de GPS pour la montre et mettre à jour la météo sur votre montre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch आपकी घड़ी पर समय-समय पर स्थान अपडेट भेजने, घड़ी के GPS के रूप में कार्य करने, और आपकी घड़ी पर मौसम अपडेट करने के लिए स्थान का उपयोग करता है।"
          }
        }
      }
    },
    "BlueWatch uses notifications to alert you during the find phone alarm when the setting is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch verwendet Benachrichtigungen, um Sie während des Alarms „Telefon suchen“ zu benachrichtigen, wenn die Einstellung aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch utiliza notificaciones para avisarte durante la alarma de buscar el teléfono cuando la opción está activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueWatch utilise les notifications pour vous alerter pendant l’alarme « Localiser mon téléphone » lorsque le réglage est actif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब सेटिंग सक्रिय हो, तो BlueWatch फ़ोन खोजें अलार्म के दौरान आपको सूचित करने के लिए सूचनाओं का उपयोग करता है।"
          }
        }
      }
    },
